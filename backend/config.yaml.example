server:
  addr: "0.0.0.0:18000"

# 可选：fight-video-create-skill 根目录。配置后UI可直接预览招式/技能GIF；
# 留空时检索和正文仍可用，只是不提供展示样本。
combat_reference_dir: ""

comfy:
  comfy_dir: /opt/comfyUI
  base_port: 8188
  gpu_count: 8
  reserve_vram: 6
  force_fp16: true
  enable_manager: true
  # 实例调度方式: ssh(默认, 算力节点裸进程) / docker(compose 容器) / local(本机裸进程)
  mode: ssh
  container_prefix: comfyui-gpu
  network: comfyui-console_default
  # 可选：跨电脑实例。实例身份是 host+port，所以不同电脑可以都使用 8188。
  # managed=false 表示平台只调度，不负责远程启停该 ComfyUI。
  # instances:
  #   - { gpu_index: 0, host: "192.168.1.101", port: 8188, managed: false }
  #   - { gpu_index: 1, host: "192.168.1.102", port: 8188, managed: false }

storage:
  db_path: /opt/comfyui-console/data/console.db
  data_dir: /opt/comfyui-console/data

gpu:
  nvidia_smi: /usr/bin/nvidia-smi
  monitor_interval_seconds: 3

# IndexTTS-2.5 执行模式：
# - comfyui：生产推荐，由现有多 ComfyUI 调度器选择安装了 Rust 节点的空闲实例；远端路径须在每台实例一致。
# - native_local：显式本机调试，Windows CUDA 发布版需使用 -tags indextts 构建并携带完整运行时。
# - disabled：禁用。
indextts:
  enabled: false
  execution_mode: comfyui
  model_dir: ""
  dll_path: ""
  device_index: 0
  language: ZH
  default_voice: ""
  timeout_seconds: 300
  queue_size: 32

# SSH 远程算力节点（单机 docker 部署：console 经 SSH 密钥在宿主执行 docker / SFTP 读写）
# 注意: 复制本文件为 config.yaml 后填写真实主机与认证信息，切勿提交密钥到仓库
remote:
  host: "127.0.0.1"
  port: 22
  user: root
  password: ""
  private_key: ""

# 任务模拟模式：无 GPU 环境下开启（true），任务将按模板参考耗时模拟进度推进直至成功，不连接 ComfyUI
simulate: false
