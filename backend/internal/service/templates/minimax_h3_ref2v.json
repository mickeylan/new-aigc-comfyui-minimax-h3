{
  "name": "MiniMax H3 SelfLift Optimized Reference Video",
  "code": "minimax_h3_ref2v",
  "description": "Exact optimized SelfLift reference-video graph, parameterized for automatic submission.",
  "inputs": [
    {
      "key": "prompt",
      "type": "prompt",
      "label": "H3 prompt",
      "required": true
    },
    {
      "key": "ref_images",
      "type": "images",
      "label": "Reference images (1-9)",
      "required": true,
      "max_count": 9
    },
    {
      "key": "duration",
      "type": "float",
      "label": "Duration",
      "default": 5,
      "min": 3,
      "max": 15
    },
    {
      "key": "steps",
      "type": "int",
      "label": "Steps",
      "default": 8,
      "min": 1,
      "max": 30
    },
    {
      "key": "seed",
      "type": "int",
      "label": "Seed",
      "default": -1,
      "min": -1
    }
  ],
  "workflow": {
    "115": {
      "inputs": {
        "aspect_ratio": "16:9 (Widescreen)",
        "megapixels": 0.6,
        "multiple": 32
      },
      "class_type": "ResolutionSelector",
      "_meta": {
        "title": "Resolution Selector (Size)"
      }
    },
    "119": {
      "inputs": {
        "vae_name": "minimax_h3\\minimax_h3_video_vae_fp16.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "加载视频VAE"
      }
    },
    "120": {
      "inputs": {
        "vae_name": "minimax_h3\\minimax_h3_audio_vae_fp32.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "加载音频VAE"
      }
    },
    "123": {
      "inputs": {
        "sampler_name": "euler"
      },
      "class_type": "KSamplerSelect",
      "_meta": {
        "title": "K采样器选择"
      }
    },
    "127": {
      "inputs": {
        "unet_name": "minimax-h3\\minimax_h3_ref2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader",
      "_meta": {
        "title": "UNet加载器"
      }
    },
    "128": {
      "inputs": {
        "clip_name": "minimax-h3\\qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
        "type": "minimax",
        "device": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": {
        "title": "加载CLIP"
      }
    },
    "131": {
      "inputs": {
        "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
        "values.a": [
          "132",
          0
        ]
      },
      "class_type": "ComfyMathExpression",
      "_meta": {
        "title": "数学表达式"
      }
    },
    "132": {
      "inputs": {
        "value": "{{duration}}"
      },
      "class_type": "PrimitiveFloat",
      "_meta": {
        "title": "视频时长(秒)"
      }
    },
    "137": {
      "inputs": {
        "image": "{{img:ref_image_0}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "加载图像"
      }
    },
    "138": {
      "inputs": {
        "value": "{{prompt}}"
      },
      "class_type": "PrimitiveStringMultiline",
      "_meta": {
        "title": "提示词"
      }
    },
    "139": {
      "inputs": {
        "image": "{{img:ref_image_1}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "加载图像"
      }
    },
    "144": {
      "inputs": {
        "image": "{{img:ref_image_2}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "加载图像"
      }
    },
    "145": {
      "inputs": {
        "image": "{{img:ref_image_3}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "加载图像"
      }
    },
    "146": {
      "inputs": {
        "image": "{{img:ref_image_4}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load reference image"
      }
    },
    "147": {
      "inputs": {
        "image": "{{img:ref_image_5}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load reference image"
      }
    },
    "148": {
      "inputs": {
        "image": "{{img:ref_image_6}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load reference image"
      }
    },
    "149": {
      "inputs": {
        "image": "{{img:ref_image_7}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load reference image"
      }
    },
    "150": {
      "inputs": {
        "image": "{{img:ref_image_8}}"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load reference image"
      }
    },
    "156": {
      "inputs": {
        "lora_name": "minimax-h3\\minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
        "strength_model": 0.7,
        "model": [
          "127",
          0
        ]
      },
      "class_type": "LoraLoaderModelOnly",
      "_meta": {
        "title": "加速LoRA"
      }
    },
    "207": {
      "inputs": {
        "seed": "{{seed}}"
      },
      "class_type": "Seed (rgthree)",
      "_meta": {
        "title": "采样种子"
      }
    },
    "211": {
      "inputs": {
        "value": "{{steps}}"
      },
      "class_type": "INTConstant",
      "_meta": {
        "title": "采样步数"
      }
    },
    "333": {
      "inputs": {
        "max_resolution": 1024,
        "jpeg_quality": 80,
        "suppress_default_preview": true,
        "preview_frames": [
          "131",
          1
        ],
        "preview_fps": 12,
        "tiny_vae": "taeh3.safetensors",
        "model": [
          "417",
          0
        ]
      },
      "class_type": "ModelPreviewOverrideKJ",
      "_meta": {
        "title": "Model Preview Override"
      }
    },
    "334": {
      "inputs": {
        "attention": "comfy kitchen attention",
        "model": [
          "156",
          0
        ]
      },
      "class_type": "ModelAttentionBackend",
      "_meta": {
        "title": "ModelAttentionBackend"
      }
    },
    "391": {
      "inputs": {
        "purge_cache": true,
        "purge_models": true,
        "anything": [
          "123",
          0
        ]
      },
      "class_type": "LayerUtility: PurgeVRAM V2",
      "_meta": {
        "title": "清除VRAM V2"
      }
    },
    "394": {
      "inputs": {
        "head_chunks": 4,
        "model": [
          "334",
          0
        ]
      },
      "class_type": "MiniMaxLowVRAMAttention",
      "_meta": {
        "title": "MiniMax H3 Low VRAM Attention"
      }
    },
    "397": {
      "inputs": {
        "seed": [
          "207",
          0
        ],
        "cfg": 1,
        "transition_step": 6,
        "lowres_scale": 0.67,
        "rho": 0,
        "w_min": 0.5,
        "w_max": 1,
        "upscaler_model": "minimax_h3_latent_upscaler_3d_fp16.safetensors",
        "highres_tiling": false,
        "latent_diagnostics": false,
        "model": [
          "333",
          0
        ],
        "positive": [
          "416",
          0
        ],
        "negative": [
          "400",
          0
        ],
        "vae": [
          "119",
          0
        ],
        "latent_image": [
          "416",
          1
        ],
        "sampler": [
          "391",
          0
        ],
        "sigmas": [
          "399",
          0
        ]
      },
      "class_type": "SelfLiftH3Sampler",
      "_meta": {
        "title": "SelfLift Progressive Sampler (MiniMax H3)"
      }
    },
    "398": {
      "inputs": {
        "scheduler": "simple",
        "steps": [
          "211",
          0
        ],
        "denoise": 1,
        "model": [
          "333",
          0
        ]
      },
      "class_type": "BasicScheduler",
      "_meta": {
        "title": "基本调度器"
      }
    },
    "399": {
      "inputs": {
        "extra_steps": 1,
        "start_at_sigma": 0.7,
        "end_at_sigma": 0,
        "spacing": "cosine",
        "sigmas": [
          "398",
          0
        ]
      },
      "class_type": "H3SigmaRefiner",
      "_meta": {
        "title": "H3 Sigma Refiner"
      }
    },
    "400": {
      "inputs": {
        "conditioning": [
          "416",
          0
        ]
      },
      "class_type": "ConditioningZeroOut",
      "_meta": {
        "title": "条件零化"
      }
    },
    "405": {
      "inputs": {
        "samples": [
          "397",
          0
        ],
        "vae": [
          "119",
          0
        ]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE解码"
      }
    },
    "408": {
      "inputs": {
        "samples": [
          "397",
          0
        ],
        "vae": [
          "120",
          0
        ]
      },
      "class_type": "VAEDecodeAudio",
      "_meta": {
        "title": "VAE解码（音频）"
      }
    },
    "416": {
      "inputs": {
        "prompt": [
          "138",
          0
        ],
        "width": [
          "115",
          0
        ],
        "height": [
          "115",
          1
        ],
        "length": [
          "131",
          1
        ],
        "ref_image_size": "match",
        "clip": [
          "128",
          0
        ],
        "vae": [
          "119",
          0
        ],
        "audio_vae": [
          "120",
          0
        ],
        "ref_images.ref_image_0": [
          "137",
          0
        ],
        "ref_images.ref_image_1": [
          "139",
          0
        ],
        "ref_images.ref_image_2": [
          "144",
          0
        ],
        "ref_images.ref_image_3": [
          "145",
          0
        ],
        "ref_images.ref_image_4": [
          "146",
          0
        ],
        "ref_images.ref_image_5": [
          "147",
          0
        ],
        "ref_images.ref_image_6": [
          "148",
          0
        ],
        "ref_images.ref_image_7": [
          "149",
          0
        ],
        "ref_images.ref_image_8": [
          "150",
          0
        ]
      },
      "class_type": "MiniMaxH3ReferenceToVideo",
      "_meta": {
        "title": "MiniMax H3 参考转视频"
      }
    },
    "417": {
      "inputs": {
        "chunks": 2,
        "seq_threshold": 4096,
        "model": [
          "394",
          0
        ]
      },
      "class_type": "MiniMaxChunkFeedForward",
      "_meta": {
        "title": "MiniMax H3 Chunk FeedForward"
      }
    },
    "418": {
      "inputs": {
        "frame_rate": 24,
        "loop_count": 0,
        "filename_prefix": "minimax/{{task_id}}",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv420p",
        "crf": 19,
        "save_metadata": true,
        "trim_to_audio": false,
        "pingpong": false,
        "save_output": true,
        "images": [
          "405",
          0
        ],
        "audio": [
          "408",
          0
        ]
      },
      "class_type": "VHS_VideoCombine",
      "_meta": {
        "title": "Video Combine 🎥🅥🅗🅢"
      }
    }
  }
}
