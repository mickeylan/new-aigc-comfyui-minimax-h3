{
  "name": "MiniMax H3 SelfLift 参考视频生成",
  "code": "minimax_h3_ref2v",
  "description": "基于已验证的小豹海螺 H3 SelfLift 工作流，按 <Picture i> 顺序输入 1-9 张参考图并生成视频。",
  "inputs": [
    { "key": "prompt", "type": "prompt", "label": "提示词", "required": true, "help": "用 <Picture 1> ... <Picture 9> 引用对应图片" },
    { "key": "ref_images", "type": "images", "label": "参考图片(1-9)", "required": true, "max_count": 9 },
    { "key": "width", "type": "int", "label": "宽度", "default": 832, "min": 256, "max": 2560, "step": 32 },
    { "key": "height", "type": "int", "label": "高度", "default": 480, "min": 256, "max": 2560, "step": 32 },
    { "key": "duration", "type": "float", "label": "时长(秒)", "default": 5, "min": 3, "max": 15 },
    { "key": "steps", "type": "int", "label": "采样步数", "default": 8, "min": 1, "max": 30 },
    { "key": "seed", "type": "int", "label": "随机种子(-1随机)", "default": -1, "min": -1 },
    { "key": "cfg", "type": "float", "label": "CFG", "default": 1, "min": 0.5, "max": 8, "step": 0.1 },
    { "key": "fps", "type": "int", "label": "输出帧率", "default": 24, "min": 1, "max": 60 },
    { "key": "ref_image_size", "type": "select", "label": "参考图缩放", "default": "match", "options": ["match", "max"] },
    { "key": "unet_name", "type": "string", "label": "UNET模型", "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors" },
    { "key": "clip_name", "type": "string", "label": "CLIP模型", "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors" },
    { "key": "video_vae_name", "type": "string", "label": "视频VAE", "default": "minimax_h3_video_vae_fp16.safetensors" },
    { "key": "audio_vae_name", "type": "string", "label": "音频VAE", "default": "minimax_h3_audio_vae_fp32.safetensors" },
    { "key": "lora_name", "type": "string", "label": "LoRA", "default": "Wuli-Qwen-Image-2512-Turbo-LoRA-4steps-V3.0-bf16.safetensors" },
    { "key": "lora_strength", "type": "float", "label": "LoRA强度", "default": 0.7 },
    { "key": "upscaler_model", "type": "string", "label": "SelfLift放大模型", "default": "none" }
  ],
  "workflow": {
    "119": { "class_type": "VAELoader", "inputs": { "vae_name": "{{video_vae_name}}" } },
    "120": { "class_type": "VAELoader", "inputs": { "vae_name": "{{audio_vae_name}}" } },
    "123": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
    "127": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unet_name}}", "weight_dtype": "default" } },
    "128": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{clip_name}}", "type": "minimax", "device": "default" } },
    "137": { "class_type": "LoadImage", "inputs": { "image": "{{img:ref_image_0}}" } },
    "139": { "class_type": "LoadImage", "inputs": { "image": "{{img:ref_image_1}}" } },
    "141": { "class_type": "LoadImage", "inputs": { "image": "{{img:ref_image_2}}" } },
    "142": { "class_type": "LoadImage", "inputs": { "image": "{{img:ref_image_3}}" } },
    "143": { "class_type": "LoadImage", "inputs": { "image": "{{img:ref_image_4}}" } },
    "144": { "class_type": "LoadImage", "inputs": { "image": "{{img:ref_image_5}}" } },
    "145": { "class_type": "LoadImage", "inputs": { "image": "{{img:ref_image_6}}" } },
    "146": { "class_type": "LoadImage", "inputs": { "image": "{{img:ref_image_7}}" } },
    "147": { "class_type": "LoadImage", "inputs": { "image": "{{img:ref_image_8}}" } },
    "156": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": { "model": ["127", 0], "lora_name": "{{lora_name}}", "strength_model": "{{lora_strength}}" }
    },
    "334": {
      "class_type": "ModelAttentionBackend",
      "inputs": { "model": ["156", 0], "attention": "comfy kitchen attention" }
    },
    "394": {
      "class_type": "MiniMaxLowVRAMAttention",
      "inputs": { "model": ["334", 0], "head_chunks": 4 }
    },
    "417": {
      "class_type": "MiniMaxChunkFeedForward",
      "inputs": { "model": ["394", 0], "chunks": 2, "seq_threshold": 4096 }
    },
    "333": {
      "class_type": "ModelPreviewOverrideKJ",
      "inputs": {
        "model": ["417", 0],
        "max_resolution": 1024,
        "jpeg_quality": 80,
        "suppress_default_preview": true,
        "preview_frames": 1,
        "preview_fps": 12,
        "tiny_vae": "taeh3.safetensors"
      }
    },
    "416": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": ["128", 0],
        "vae": ["119", 0],
        "audio_vae": ["120", 0],
        "ref_images": {
          "ref_image_0": ["137", 0],
          "ref_image_1": ["139", 0],
          "ref_image_2": ["141", 0],
          "ref_image_3": ["142", 0],
          "ref_image_4": ["143", 0],
          "ref_image_5": ["144", 0],
          "ref_image_6": ["145", 0],
          "ref_image_7": ["146", 0],
          "ref_image_8": ["147", 0]
        },
        "prompt": "{{prompt}}",
        "width": "{{width}}",
        "height": "{{height}}",
        "length": "{{length}}",
        "ref_image_size": "{{ref_image_size}}"
      }
    },
    "398": {
      "class_type": "BasicScheduler",
      "inputs": { "model": ["333", 0], "scheduler": "simple", "steps": "{{steps}}", "denoise": 1 }
    },
    "399": {
      "class_type": "H3SigmaRefiner",
      "inputs": { "sigmas": ["398", 0], "extra_steps": 1, "start_at_sigma": 0.7, "end_at_sigma": 0, "spacing": "cosine" }
    },
    "400": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["416", 0] } },
    "397": {
      "class_type": "SelfLiftH3Sampler",
      "inputs": {
        "model": ["333", 0],
        "positive": ["416", 0],
        "negative": ["400", 0],
        "vae": ["119", 0],
        "latent_image": ["416", 1],
        "sampler": ["123", 0],
        "sigmas": ["399", 0],
        "seed": "{{seed}}",
        "cfg": "{{cfg}}",
        "transition_step": 6,
        "lowres_scale": 0.67,
        "rho": 0.05,
        "w_min": 0.5,
        "w_max": 1,
        "upscaler_model": "{{upscaler_model}}",
        "highres_tiling": false,
        "latent_diagnostics": false
      }
    },
    "405": { "class_type": "VAEDecode", "inputs": { "samples": ["397", 0], "vae": ["119", 0] } },
    "408": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["397", 0], "vae": ["120", 0] } },
    "410": {
      "class_type": "CreateVideo",
      "inputs": { "images": ["405", 0], "fps": "{{fps}}", "audio": ["408", 0] }
    },
    "411": {
      "class_type": "SaveVideo",
      "inputs": { "video": ["410", 0], "filename_prefix": "minimax/{{task_id}}", "format": "mp4", "codec": "auto" }
    }
  }
}
