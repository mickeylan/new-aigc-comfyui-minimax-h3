{
  "name": "MiniMax H3 SelfLift 分镜候选视频",
  "code": "minimax_h3_storyboard_candidates_selflift",
  "description": "使用两张角色/资产参考图生成短分镜候选视频，供后续自动抽帧和人工选择。",
  "inputs": [
    {
      "key": "prompt",
      "type": "prompt",
      "label": "分镜动作提示词",
      "required": true
    },
    {
      "key": "ref_images",
      "type": "images",
      "label": "参考图",
      "required": true,
      "max_count": 2
    },
    {
      "key": "width",
      "type": "int",
      "label": "宽度",
      "default": 928,
      "min": 256,
      "max": 2560,
      "step": 32
    },
    {
      "key": "height",
      "type": "int",
      "label": "高度",
      "default": 1664,
      "min": 256,
      "max": 2560,
      "step": 32
    },
    {
      "key": "duration",
      "type": "float",
      "label": "候选时长(秒)",
      "default": 1,
      "min": 0.2,
      "max": 5,
      "step": 0.1
    },
    {
      "key": "seed",
      "type": "int",
      "label": "随机种子",
      "default": -1,
      "min": -1
    },
    {
      "key": "steps",
      "type": "int",
      "label": "采样步数",
      "default": 8,
      "min": 1,
      "max": 30
    },
    {
      "key": "fps",
      "type": "int",
      "label": "输出帧率",
      "default": 24,
      "min": 1,
      "max": 60
    },
    {
      "key": "unet_name",
      "type": "string",
      "label": "unet_name",
      "default": "海螺\\minimax_h3_ref2va_bf16.safetensors"
    },
    {
      "key": "clip_name",
      "type": "string",
      "label": "clip_name",
      "default": "qwen3vl_32b_minimax_h3_ultra_uncensored_heretic_int8_convrot.safetensors"
    },
    {
      "key": "video_vae_name",
      "type": "string",
      "label": "video_vae_name",
      "default": "海螺\\minimax_h3_video_vae_int8_convrot.safetensors"
    },
    {
      "key": "audio_vae_name",
      "type": "string",
      "label": "audio_vae_name",
      "default": "海螺\\minimax_h3_audio_vae_fp32.safetensors"
    },
    {
      "key": "lora_name",
      "type": "string",
      "label": "lora_name",
      "default": "海螺H3\\minimax_h3_fl2v_lightx2v_turbo_4step_v0.1_comfy-kj-convert.safetensors"
    },
    {
      "key": "lora_strength",
      "type": "float",
      "label": "lora_strength",
      "default": 0.7
    },
    {
      "key": "upscaler_model",
      "type": "string",
      "label": "upscaler_model",
      "default": "minimax_h3_latent_upscaler_3d_fp16.safetensors"
    }
  ],
  "workflow": {
    "127": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{{unet_name}}",
        "weight_dtype": "default"
      }
    },
    "128": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "{{clip_name}}",
        "type": "minimax",
        "device": "default"
      }
    },
    "119": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{{video_vae_name}}"
      }
    },
    "120": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{{audio_vae_name}}"
      }
    },
    "137": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_0}}"
      }
    },
    "139": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_1}}"
      }
    },
    "156": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "127",
          0
        ],
        "lora_name": "{{lora_name}}",
        "strength_model": "{{lora_strength}}"
      }
    },
    "334": {
      "class_type": "ModelAttentionBackend",
      "inputs": {
        "model": [
          "156",
          0
        ],
        "attention": "comfy kitchen attention"
      }
    },
    "394": {
      "class_type": "MiniMaxLowVRAMAttention",
      "inputs": {
        "model": [
          "334",
          0
        ],
        "head_chunks": 4
      }
    },
    "417": {
      "class_type": "MiniMaxChunkFeedForward",
      "inputs": {
        "model": [
          "394",
          0
        ],
        "chunks": 2,
        "seq_threshold": 4096
      }
    },
    "333": {
      "class_type": "ModelPreviewOverrideKJ",
      "inputs": {
        "model": [
          "417",
          0
        ],
        "max_resolution": 1024,
        "jpeg_quality": 80,
        "suppress_default_preview": true,
        "preview_frames": 1,
        "preview_fps": 12,
        "tiny_vae": "taeh3.safetensors"
      }
    },
    "416": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "128",
          0
        ],
        "vae": [
          "119",
          0
        ],
        "audio_vae": [
          "120",
          0
        ],
        "ref_images": {
          "ref_image_0": [
            "137",
            0
          ],
          "ref_image_1": [
            "139",
            0
          ]
        },
        "prompt": "{{prompt}}",
        "width": "{{width}}",
        "height": "{{height}}",
        "length": "{{length}}",
        "ref_image_size": "match"
      }
    },
    "400": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "416",
          0
        ]
      }
    },
    "398": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "333",
          0
        ],
        "scheduler": "simple",
        "steps": "{{steps}}",
        "denoise": 1
      }
    },
    "399": {
      "class_type": "H3SigmaRefiner",
      "inputs": {
        "sigmas": [
          "398",
          0
        ],
        "extra_steps": 1,
        "start_at_sigma": 0.7,
        "end_at_sigma": 0,
        "spacing": "cosine"
      }
    },
    "123": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "397": {
      "class_type": "SelfLiftH3Sampler",
      "inputs": {
        "model": [
          "333",
          0
        ],
        "positive": [
          "416",
          0
        ],
        "negative": [
          "400",
          0
        ],
        "vae": [
          "119",
          0
        ],
        "latent_image": [
          "416",
          1
        ],
        "sampler": [
          "123",
          0
        ],
        "sigmas": [
          "399",
          0
        ],
        "seed": "{{seed}}",
        "cfg": 1,
        "transition_step": 6,
        "lowres_scale": 0.67,
        "rho": 0,
        "w_min": 0.5,
        "w_max": 1,
        "upscaler_model": "{{upscaler_model}}",
        "highres_tiling": false
      }
    },
    "405": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "397",
          0
        ],
        "vae": [
          "119",
          0
        ]
      }
    },
    "408": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "397",
          0
        ],
        "vae": [
          "120",
          0
        ]
      }
    },
    "414": {
      "class_type": "VideoCombineV2",
      "inputs": {
        "images": [
          "405",
          0
        ],
        "audio": [
          "408",
          0
        ],
        "frame_rate": "{{fps}}",
        "loop_count": 0,
        "filename_prefix": "storyboard_candidates/{{task_id}}",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv420p",
        "crf": 19,
        "save_metadata": true,
        "trim_to_audio": false,
        "pingpong": false,
        "save_output": true
      }
    }
  }
}