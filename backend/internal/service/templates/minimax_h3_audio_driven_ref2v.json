{
  "name": "MiniMax H3 已审核音频驱动参考视频",
  "code": "minimax_h3_audio_driven_ref2v",
  "description": "官方H3参考/音频锚链路，附带MIT音频窗口、17k+5规划、精确画面裁切、音轨策略与质量审计。默认source_only保留审核后的IndexTTS原音；generated_only和mix必须显式选择。",
  "inputs": [
    {
      "key": "dialogue_audio",
      "type": "audio",
      "label": "已审核人物对白音频",
      "required": true
    },
    {
      "key": "audio_scene_start",
      "type": "float",
      "label": "音频片段开始秒",
      "default": 0,
      "min": 0
    },
    {
      "key": "audio_scene_duration",
      "type": "float",
      "label": "目标对白时长（0=音频剩余部分）",
      "default": 0,
      "min": 0,
      "max": 60
    },
    {
      "key": "audio_warmup",
      "type": "float",
      "label": "口型预热秒",
      "default": 0,
      "min": 0,
      "max": 10
    },
    {
      "key": "audio_cooldown",
      "type": "float",
      "label": "表演收尾秒",
      "default": 0,
      "min": 0,
      "max": 10
    },
    {
      "key": "audio_policy",
      "type": "select",
      "label": "最终音轨策略",
      "default": "source_only",
      "options": [
        "source_only",
        "generated_only",
        "mix"
      ]
    },
    {
      "key": "prompt",
      "type": "prompt",
      "label": "H3 prompt",
      "required": true
    },
    {
      "key": "ref_images",
      "type": "images",
      "label": "Reference images (1-9)",
      "required": true,
      "max_count": 9
    },
    {
      "key": "duration",
      "type": "float",
      "label": "Duration",
      "default": 5,
      "min": 3,
      "max": 15
    },
    {
      "key": "steps",
      "type": "int",
      "label": "Steps",
      "default": 8,
      "min": 1,
      "max": 30
    },
    {
      "key": "seed",
      "type": "int",
      "label": "Seed",
      "default": -1,
      "min": -1
    },
    {
      "key": "free_vram_override_gb",
      "type": "float",
      "label": "空闲显存覆盖GiB（0=运行时自动读取）",
      "default": 0,
      "min": 0,
      "max": 256
    },
    {
      "key": "max_av_delta_ms",
      "type": "float",
      "label": "最大音画时长差毫秒",
      "default": 50,
      "min": 0,
      "max": 5000
    },
    {
      "key": "fail_on_av_mismatch",
      "type": "bool",
      "label": "音画时长不一致时阻断",
      "default": true
    },
    {
      "key": "source_gain_db",
      "type": "float",
      "label": "审核对白增益dB",
      "default": 0,
      "min": -60,
      "max": 24
    },
    {
      "key": "generated_gain_db",
      "type": "float",
      "label": "H3环境音增益dB",
      "default": -12,
      "min": -60,
      "max": 24
    },
    {
      "key": "duck_generated",
      "type": "float",
      "label": "对白期间压低H3音轨",
      "default": 0.75,
      "min": 0,
      "max": 1
    },
    {
      "key": "peak_limit_dbfs",
      "type": "float",
      "label": "最终峰值限制dBFS",
      "default": -1,
      "min": -12,
      "max": 0
    },
    {
      "key": "output_sample_rate",
      "type": "select",
      "label": "最终采样率",
      "default": "source",
      "options": [
        "source",
        "generated",
        "48000",
        "44100",
        "32000",
        "22050"
      ]
    }
  ],
  "workflow": {
