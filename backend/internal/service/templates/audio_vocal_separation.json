{
  "name": "视频片段人声分离（角色参考语音）",
  "code": "audio_vocal_separation",
  "description": "以Hybrid Demucs从用户选定的视频音频片段中只保留Vocals，作为角色参考语音草稿；不做语音识别，需用户试听确认后才绑定角色。",
  "inputs": [
    {"key":"source_audio","type":"audio","label":"视频片段音频","required":true}
  ],
  "workflow": {
    "1": {"class_type":"LoadAudio","inputs":{"audio":"{{aud:source_audio}}"}},
    "2": {"class_type":"AudioSeparation","inputs":{"audio":["1",0],"chunk_fade_shape":"linear","chunk_length":10,"chunk_overlap":0.1}},
    "3": {"class_type":"SaveAudio","inputs":{"audio":["2",3],"filename_prefix":"voice_extract/vocals_{{task_id}}"}}
  }
}
