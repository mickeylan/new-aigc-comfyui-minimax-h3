{
  "name": "Moss 文生图",
  "code": "moss_image_t2i",
  "description": "Moss 两阶段采样通用文生图，用于道具、场景资产参考图。",
  "inputs": [
    { "key": "prompt", "type": "prompt", "label": "提示词", "required": true },
    { "key": "negative_prompt", "type": "string", "label": "负面提示词", "default": "worst quality, bad anatomy, watermark, jpeg artifact" },
    { "key": "aspect_ratio", "type": "select", "label": "输出画幅", "default": "16:9 (Widescreen)", "options": ["1:1 (Square)", "2:3 (Portrait Photo)", "3:2 (Photo)", "3:4 (Portrait Standard)", "4:3 (Standard)", "9:16 (Portrait Widescreen)", "16:9 (Widescreen)", "21:9 (Ultrawide)"] },
    { "key": "megapixels", "type": "float", "label": "输出百万像素", "default": 2, "min": 0.1, "max": 16, "step": 0.1 },
    { "key": "multiple", "type": "int", "label": "尺寸倍数", "default": 16, "min": 8, "max": 128, "step": 4 },
    { "key": "seed", "type": "int", "label": "随机种子", "default": -1, "min": -1 },
    { "key": "unet_name", "type": "string", "label": "UNET", "default": "moss\\moss_image_sft_int8_convrot.safetensors" },
    { "key": "clip_name", "type": "string", "label": "CLIP", "default": "moss\\qwen3.5_9b_int8_convrot.safetensors" },
    { "key": "vae_name", "type": "string", "label": "VAE", "default": "moss\\flux2-vae.safetensors" }
  ],
  "workflow": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unet_name}}", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{clip_name}}", "type": "moss_image", "device": "default" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae_name}}" } },
    "4": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{negative_prompt}}", "clip": ["2", 0] } },
    "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["2", 0] } },
    "7": { "class_type": "LatentUpscaleBy", "inputs": { "upscale_method": "bicubic", "scale_by": 1.2, "samples": ["10", 0] } },
    "8": { "class_type": "VAEDecode", "inputs": { "samples": ["13", 0], "vae": ["3", 0] } },
    "9": { "class_type": "SkipLayerGuidanceDiTSimple", "inputs": { "double_layers": "", "single_layers": "22", "start_percent": 0, "end_percent": 0.5, "model": ["1", 0] } },
    "10": { "class_type": "KSamplerAdvanced", "inputs": { "add_noise": "enable", "noise_seed": "{{seed}}", "steps": 16, "cfg": 3, "sampler_name": "er_sde", "scheduler": "simple", "start_at_step": 0, "end_at_step": 12, "return_with_leftover_noise": "enable", "model": ["9", 0], "positive": ["5", 0], "negative": ["4", 0], "latent_image": ["11", 0] } },
    "11": { "class_type": "EmptyLatentImage", "inputs": { "width": ["12", 0], "height": ["12", 1], "batch_size": 1 } },
    "12": { "class_type": "ResolutionSelector", "inputs": { "aspect_ratio": "{{aspect_ratio}}", "megapixels": "{{megapixels}}", "multiple": "{{multiple}}" } },
    "13": { "class_type": "KSamplerAdvanced", "inputs": { "add_noise": "enable", "noise_seed": 666, "steps": 25, "cfg": 3, "sampler_name": "euler", "scheduler": "simple", "start_at_step": 9, "end_at_step": 25, "return_with_leftover_noise": "disable", "model": ["9", 0], "positive": ["5", 0], "negative": ["4", 0], "latent_image": ["7", 0] } },
    "14": { "class_type": "SaveImage", "inputs": { "filename_prefix": "moss/asset_{{task_id}}", "images": ["8", 0] } }
  }
}
