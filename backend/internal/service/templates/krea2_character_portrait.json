{
  "name": "Krea2 角色正面特写",
  "code": "krea2_character_portrait",
  "description": "Krea2 两阶段采样生成角色正面特写，作为角色权威身份参考图。",
  "inputs": [
    {
      "key": "prompt",
      "type": "prompt",
      "label": "角色提示词",
      "required": true
    },
    {
      "key": "width",
      "type": "int",
      "label": "宽度",
      "default": 768,
      "min": 256,
      "max": 2048,
      "step": 8
    },
    {
      "key": "height",
      "type": "int",
      "label": "高度",
      "default": 1344,
      "min": 256,
      "max": 2048,
      "step": 8
    },
    {
      "key": "seed",
      "type": "int",
      "label": "随机种子",
      "default": -1,
      "min": -1
    },
    {
      "key": "steps",
      "type": "int",
      "label": "第一阶段步数",
      "default": 8,
      "min": 1,
      "max": 50
    },
    {
      "key": "cfg",
      "type": "float",
      "label": "CFG",
      "default": 1,
      "min": 0.1,
      "max": 20,
      "step": 0.1
    },
    {
      "key": "unet_name",
      "type": "string",
      "label": "unet_name",
      "default": "Krea2\\Krea2-Moody-Mix-premium_int8_convrot.safetensors"
    },
    {
      "key": "clip_name",
      "type": "string",
      "label": "clip_name",
      "default": "qwen3vl_4b_fp8_scaled.safetensors"
    },
    {
      "key": "vae_name",
      "type": "string",
      "label": "vae_name",
      "default": "qwen_image_vae.safetensors"
    }
  ],
  "workflow": {
    "26": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{{unet_name}}",
        "weight_dtype": "default"
      }
    },
    "29": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "{{clip_name}}",
        "type": "krea2",
        "device": "default"
      }
    },
    "24": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{{vae_name}}"
      }
    },
    "25": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "29",
          0
        ],
        "text": "{{prompt}}"
      }
    },
    "15": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "25",
          0
        ]
      }
    },
    "16": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "{{width}}",
        "height": "{{height}}",
        "batch_size": 1
      }
    },
    "21": {
      "class_type": "KSamplerAdvanced",
      "inputs": {
        "model": [
          "26",
          0
        ],
        "positive": [
          "25",
          0
        ],
        "negative": [
          "15",
          0
        ],
        "latent_image": [
          "16",
          0
        ],
        "noise_seed": "{{seed}}",
        "add_noise": "enable",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "start_at_step": 0,
        "end_at_step": "{{steps}}",
        "return_with_leftover_noise": "disable"
      }
    },
    "22": {
      "class_type": "LatentUpscaleBy",
      "inputs": {
        "samples": [
          "21",
          0
        ],
        "upscale_method": "bicubic",
        "scale_by": 1.5
      }
    },
    "13": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "26",
          0
        ],
        "positive": [
          "25",
          0
        ],
        "negative": [
          "15",
          0
        ],
        "latent_image": [
          "22",
          0
        ],
        "seed": "{{seed}}",
        "steps": 4,
        "cfg": "{{cfg}}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.54
      }
    },
    "18": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "13",
          0
        ],
        "vae": [
          "24",
          0
        ]
      }
    },
    "6": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "18",
          0
        ],
        "filename_prefix": "krea2/character_{{task_id}}"
      }
    }
  }
}