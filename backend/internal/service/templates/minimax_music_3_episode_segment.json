{
  "name": "MiniMax Music 3 整集配乐分段",
  "code": "minimax_music_3_episode_segment",
  "description": "使用官方MiniMax Music 3节点生成已审核的整集配乐分段；每段最长300秒，纯器乐，输出FLAC供试听审核和整集合并。",
  "inputs": [
    {"key":"caption","type":"string","label":"Structured Caption","required":true},
    {"key":"lyrics","type":"string","label":"结构标签","required":true,"default":"[Intro]\n[Instrumental]\n[Outro]"},
    {"key":"duration","type":"float","label":"分段时长","required":true,"default":120,"min":5,"max":300,"step":0.04},
    {"key":"seed","type":"int","label":"种子","required":true,"default":-1},
    {"key":"unet_name","type":"string","label":"扩散模型","required":true,"default":"minimax-music3\\minimax_music3_dit_fp32.safetensors"},
    {"key":"clip_name","type":"string","label":"文本编码器","required":true,"default":"minimax-music3\\minimax_music3_text_encoder_bf16.safetensors"},
    {"key":"vae_name","type":"string","label":"音频VAE","required":true,"default":"MiniMax-Music-3\\minimax_music3_dav.safetensors"}
  ],
  "workflow": {
    "1": {"class_type":"UNETLoader","inputs":{"unet_name":"{{unet_name}}","weight_dtype":"default"}},
    "2": {"class_type":"CLIPLoader","inputs":{"clip_name":"{{clip_name}}","type":"minimax","device":"default"}},
    "3": {"class_type":"VAELoader","inputs":{"vae_name":"{{vae_name}}"}},
    "4": {"class_type":"MiniMaxMusic3TextEncode","inputs":{"clip":["2",0],"caption":"{{caption}}","lyrics":"{{lyrics}}","seed":"{{seed}}","max_duration":"{{duration}}","cfg_scale":1.7,"top_k":50}},
    "5": {"class_type":"ConditioningZeroOut","inputs":{"conditioning":["4",0]}},
    "6": {"class_type":"EmptyMiniMaxMusic3LatentAudio","inputs":{"seconds":["4",1],"batch_size":1}},
    "7": {"class_type":"KSampler","inputs":{"model":["1",0],"positive":["4",0],"negative":["5",0],"latent_image":["6",0],"seed":"{{seed}}","steps":30,"cfg":1.7,"sampler_name":"euler","scheduler":"simple","denoise":1}},
    "8": {"class_type":"VAEDecodeAudioTiled","inputs":{"samples":["7",0],"vae":["3",0],"tile_size":1536,"overlap":64}},
    "9": {"class_type":"SaveAudio","inputs":{"audio":["8",0],"filename_prefix":"music3/episode_segment_{{task_id}}"}}
  }
}
