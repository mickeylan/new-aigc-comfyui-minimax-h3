{
  "name": "MiniMax H3 SelfLift 标准像换装",
  "code": "minimax_h3_look_reference",
  "description": "复用已验证的 SelfLift 多参考链，以角色原始标准像锁定身份，生成 9:16 正面全身新形象定妆照并抽帧；其余参考图约束服装、鞋履、发型和配饰。",
  "inputs": [
    {
      "key": "prompt",
      "type": "prompt",
      "label": "造型描述",
      "required": true,
      "help": "<Picture 1>=定妆照（脸部身份锚点），<Picture 2+>=发型/配饰参考（可选）"
    },
    {
      "key": "ref_images",
      "type": "images",
      "label": "参考图片(1=定妆照脸部锚点, 2+=发型/配饰参考)",
      "required": true,
      "max_count": 9
    },
    {
      "key": "width",
      "type": "int",
      "label": "宽度",
      "default": 928,
      "min": 256,
      "max": 2560,
      "step": 32
    },
    {
      "key": "height",
      "type": "int",
      "label": "高度(9:16竖版)",
      "default": 1664,
      "min": 256,
      "max": 2560,
      "step": 32
    },
    {
      "key": "duration",
      "type": "float",
      "label": "生成帧数（固定5帧）",
      "default": 0.21,
      "min": 0.2,
      "max": 0.42,
      "step": 0.1
    },
    {
      "key": "seed",
      "type": "int",
      "label": "随机种子",
      "default": -1,
      "min": -1
    },
    {
      "key": "steps",
      "type": "int",
      "label": "采样步数",
      "default": 8,
      "min": 1,
      "max": 30
    },
    {
      "key": "fps",
      "type": "int",
      "label": "输出帧率",
      "default": 24,
      "min": 1,
      "max": 60
    },
    {
      "key": "unet_name",
      "type": "string",
      "label": "unet_name",
      "default": "minimax-h3\\minimax_h3_ref2va_pruned_int8_convrot.safetensors"
    },
    {
      "key": "clip_name",
      "type": "string",
      "label": "clip_name",
      "default": "minimax-h3\\qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
    },
    {
      "key": "video_vae_name",
      "type": "string",
      "label": "video_vae_name",
      "default": "minimax_h3\\minimax_h3_video_vae_fp16.safetensors"
    },
    {
      "key": "audio_vae_name",
      "type": "string",
      "label": "audio_vae_name",
      "default": "minimax_h3\\minimax_h3_audio_vae_fp32.safetensors"
    },
    {
      "key": "lora_name",
      "type": "string",
      "label": "lora_name",
      "default": "minimax-h3\\minimax_h3_fl2v_lightx2v_turbo_4step_v0.1_comfy.safetensors"
    },
    {
      "key": "lora_strength",
      "type": "float",
      "label": "lora_strength",
      "default": 0.7
    },
    {
      "key": "upscaler_model",
      "type": "string",
      "label": "upscaler_model",
      "default": "minimax_h3_latent_upscaler_3d_fp16.safetensors"
    }
  ],
  "workflow": {
    "119": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{{video_vae_name}}"
      }
    },
    "120": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{{audio_vae_name}}"
      }
    },
    "123": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "127": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{{unet_name}}",
        "weight_dtype": "default"
      }
    },
    "128": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "{{clip_name}}",
        "type": "minimax",
        "device": "default"
      }
    },
    "137": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_0}}"
      }
    },
    "139": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_1}}"
      }
    },
    "141": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_2}}"
      }
    },
    "142": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_3}}"
      }
    },
    "143": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_4}}"
      }
    },
    "144": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_5}}"
      }
    },
    "145": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_6}}"
      }
    },
    "146": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_7}}"
      }
    },
    "147": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{img:ref_image_8}}"
      }
    },
    "156": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "127",
          0
        ],
        "lora_name": "{{lora_name}}",
        "strength_model": "{{lora_strength}}"
      }
    },
    "333": {
      "class_type": "ModelPreviewOverrideKJ",
      "inputs": {
        "model": [
          "417",
          0
        ],
        "max_resolution": 1024,
        "jpeg_quality": 80,
        "suppress_default_preview": true,
        "preview_frames": 1,
        "preview_fps": 12,
        "tiny_vae": "taeh3.safetensors"
      }
    },
    "334": {
      "class_type": "ModelAttentionBackend",
      "inputs": {
        "model": [
          "156",
          0
        ],
        "attention": "comfy kitchen attention"
      }
    },
    "394": {
      "class_type": "MiniMaxLowVRAMAttention",
      "inputs": {
        "model": [
          "334",
          0
        ],
        "head_chunks": 4
      }
    },
    "397": {
      "class_type": "SelfLiftH3Sampler",
      "inputs": {
        "model": [
          "333",
          0
        ],
        "positive": [
          "416",
          0
        ],
        "negative": [
          "400",
          0
        ],
        "vae": [
          "119",
          0
        ],
        "latent_image": [
          "416",
          1
        ],
        "sampler": [
          "123",
          0
        ],
        "sigmas": [
          "399",
          0
        ],
        "seed": "{{seed}}",
        "cfg": 1,
        "transition_step": 6,
        "lowres_scale": 0.67,
        "rho": 0,
        "w_min": 0.5,
        "w_max": 1,
        "upscaler_model": "{{upscaler_model}}",
        "highres_tiling": false
      }
    },
    "398": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "333",
          0
        ],
        "scheduler": "simple",
        "steps": "{{steps}}",
        "denoise": 1
      }
    },
    "399": {
      "class_type": "H3SigmaRefiner",
      "inputs": {
        "sigmas": [
          "398",
          0
        ],
        "extra_steps": 1,
        "start_at_sigma": 0.7,
        "end_at_sigma": 0,
        "spacing": "cosine"
      }
    },
    "400": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "416",
          0
        ]
      }
    },
    "405": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "397",
          0
        ],
        "vae": [
          "119",
          0
        ]
      }
    },
    "413": {
      "class_type": "ImageFromBatch",
      "inputs": {
        "image": [
          "405",
          0
        ],
        "batch_index": 2,
        "length": 1
      }
    },
    "414": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "413",
          0
        ],
        "filename_prefix": "look_reference/{{task_id}}"
      }
    },
    "416": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": [
          "128",
          0
        ],
        "vae": [
          "119",
          0
        ],
        "audio_vae": [
          "120",
          0
        ],
        "ref_images": {
          "ref_image_0": [
            "137",
            0
          ],
          "ref_image_1": [
            "139",
            0
          ],
          "ref_image_2": [
            "141",
            0
          ],
          "ref_image_3": [
            "142",
            0
          ],
          "ref_image_4": [
            "143",
            0
          ],
          "ref_image_5": [
            "144",
            0
          ],
          "ref_image_6": [
            "145",
            0
          ],
          "ref_image_7": [
            "146",
            0
          ],
          "ref_image_8": [
            "147",
            0
          ]
        },
        "prompt": "{{prompt}}",
        "width": "{{width}}",
        "height": "{{height}}",
        "length": "{{length}}",
        "ref_image_size": "match"
      }
    },
    "417": {
      "class_type": "MiniMaxChunkFeedForward",
      "inputs": {
        "model": [
          "394",
          0
        ],
        "chunks": 2,
        "seq_threshold": 4096
      }
    }
  }
}
